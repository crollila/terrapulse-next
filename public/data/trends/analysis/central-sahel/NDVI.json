3296703,"share_significant_opposite_direction":0.0,"slope_min":-0.0004932852206317423,"slope_max":0.024828502431075605},"verdict":{"code":"robust","title":"Significant rising trend that holds across date ranges","text":"Over 2000-2026 the series changed by +0.011 NDVI per decade. Both significance tests agree after allowing for month-to-month persistence, and 98% of all date windows of 15+ years point the same way.","direction":"rising"},"crosscheck":{"code":"none","label":"No second dataset checked","text":"This result has not been compared with an independent dataset. It describes this dataset; whether another record would show the same is not known."},"quality":{"months_total":321,"months_missing":0,"coverage":1.0,"grid_cells":1250,"min_cells_valid":1153,"lag1_autocorrelation":0.7916605860720144,"n_effective":37.32679749209782,"units_reported_by_nasa":"NDVI (unitless; stored integer x 0.0001)","months_used":321,"calendar_months_excluded":[]},"provenance":{"request_url":null,"retrieved_utc":"2026-11-14","api_version":null,"api_title":null,"sources":["MOD13C2.061"],"units_reported":"NDVI (unitless; stored integer x 0.0001)","longname_reported":"CMG 0.05 Deg Monthly NDVI","grid":{"n_cells":1250,"lat_min":12.0,"lat_max":17.0,"lon_min":0.0,"lon_max":10.0},"months_total":321,"months_missing":0,"first_month":"2000-02","last_month":"2026-10","doi":"10.5067/MODIS/MOD13C2.061","processed_by":"Kawtar Ag","processing":{"resampling":"Mean of 4x4 blocks of 0.05 degree pixels to a 0.2 degree grid. Fill value (-3000) and values outside -2000..10000 were removed before averaging. A 0.2 degree cell was kept only if at least 8 of its 16 source pixels were valid.","quality_filter":"Pixel reliability layer: only codes 0 (good) and 1 (marginal) kept. Codes -1 (fill), 2 (snow/ice), 3 (cloudy) and 4 (estimated from the historical record) excluded."},"min_cell_fraction":0.5,"source":{"id":"mod13c2","short_name":"NASA MODIS/Terra vegetation index (MOD13C2 v6.1)","dataset":"MODIS/Terra Veg