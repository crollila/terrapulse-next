irection":0.01098901098901099,"slope_min":-0.02828109253169104,"slope_max":0.022228632644948003},"verdict":{"code":"not_detected","title":"No significant trend detected","text":"Over 2000-2026 the estimated change is -0.000162 NDVI per decade, which cannot be told apart from natural variability. If the true trend were this size, about 642 years of data (range 485-850) would be needed to detect it reliably; the record has 27.","direction":"falling"},"crosscheck":{"code":"none","label":"No second dataset checked","text":"This result has not been compared with an independent dataset. It describes this dataset; whether another record would show the same is not known."},"quality":{"months_total":321,"months_missing":0,"coverage":1.0,"grid_cells":830,"min_cells_valid":791,"lag1_autocorrelation":0.8679286614416163,"n_effective":22.696209203472442,"units_reported_by_nasa":"NDVI (unitless; stored integer x 0.0001)","months_used":321,"calendar_months_excluded":[]},"provenance":{"request_url":null,"retrieved_utc":"2026-11-14","api_version":null,"api_title":null,"sources":["MOD13C2.061"],"units_reported":"NDVI (unitless; stored integer x 0.0001)","longname_reported":"CMG 0.05 Deg Monthly NDVI","grid":{"n_cells":830,"lat_min":30.0,"lat_max":35.0,"lon_min":-10.0,"lon_max":-2.0},"months_total":321,"months_missing":0,"first_month":"2000-02","last_month":"2026-10","doi":"10.5067/MODIS/MOD13C2.061","processed_by":"Kawtar Ag","processing":{"resampling":"Mean of 4x4 blocks of 0.05 degree pixels to a 0.2 degree grid. Fill value (-3000) and values outside -2000..10000 were removed before averaging. A 0.2 degree cell was kept only if at least 8 of its 16 source pixels were valid.","quality_filter":"Pixel reliability layer: only codes 0 (good) and 1 (marginal) kept. Codes -1 (fill), 2 (snow/ice), 3 (cloudy) and 4 (estimated from the historical record) excluded."},"min_cell_fraction":0.5,"source":{"id":"mod13c2","short_name":"NASA MODIS/Terra vegetation index (MOD13C2 v6.1)","dataset":"MODIS/Terra Vegetation Indices Monthly L3 Global 0.05Deg CMG, Version 6.1 (MOD13C2)","producer":"NASA MODIS Land Science Team; distributed by NASA LP DAAC","access":"NASA LP DAAC (Earthdata); regional means computed by the team","access_short":"NASA LP DAAC","access_url":"https://doi.org/10.5067/MODIS/MOD13C2.061","doi":"10.5067/MODIS/MOD13C2.061","native_grid":"0.05\u00b0 latitude x 0.05\u00b0 longitude (climate modeling grid)","kind":"Satellite observation: a vegetation index computed from red and near-infrared reflectance measured by the MODIS instrument on NASA's Terra satellite.","caveat":"NDVI is a satellite measurement of greenness, not a direct measure of plant health or biomass. Clouds, snow, smoke and low sun angles lower it, and it saturates over dense forest. The record starts in 2000, so it is shorter than the 1981-2025 weather variables and trends are harder to detect. The Terra satellite's overpass time has drifted earlier since 2020, which NASA reports is affecting recent data, so treat changes after about 2022 with extra care.","credit":"NASA MODIS/Terra MOD13C2 v6.1 via NASA LP DAAC"}}}