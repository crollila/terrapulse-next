{
  "name": "terrapulse-next",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TerraPulse: Earth intelligence, economic foresight. Static, deterministic, source-traced.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "snapshot": "node scripts/fetch-snapshots.mjs",
    "status": "node scripts/status.mjs",
    "predev": "node scripts/copy-map-worker.mjs",
    "prebuild": "node scripts/copy-map-worker.mjs",
    "postinstall": "node scripts/copy-map-worker.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "status:quick": "node scripts/status.mjs --quick",
    "check:live": "node scripts/status.mjs --quick --e2e",
    "dashboard": "node scripts/dashboard.mjs",
    "resume": "node scripts/resume.mjs",
    "capture": "node scripts/capture.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^6.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
